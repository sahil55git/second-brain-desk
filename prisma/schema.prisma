// Second Brain Desk — Phase 1 schema
// Models exactly the two desks ported in this phase: Job-Work Desk and
// Daily Closing. See README.md and claude/dashboard-app-plan.md (project
// docs) for the full artifact this is being migrated from.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Which side keeps the oil cake at settlement (Scenario A vs B in the
// job-work SOP). SHOP = shop keeps cake, shop pays customer ~₹6/kg.
// CUSTOMER = customer keeps cake, customer pays shop ~₹10/kg.
enum CakeOwnership {
  SHOP
  CUSTOMER
}

// Two-tier role model (claude/erp-architecture-plan.md, Phase 1) — Owner
// sees everything including Settings/financial reports; Staff can log
// operational entries but not see Settings or financial reports. Not
// multi-tenant: one business, two access levels.
enum UserRole {
  OWNER
  STAFF
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  name         String
  role         UserRole @default(STAFF)
  active       Boolean  @default(true)
  // Access profile key (see lib/access.ts). Null on older staff logins = manager.
  profileKey   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Unified customer/supplier master (erp-architecture-plan.md, Phase 1).
// A single party can be both (e.g. someone who both sells seed to the
// shop and buys oil from it) — `type` is a tag for filtering UI lists,
// not an exclusive category.
enum PartyType {
  CUSTOMER
  SUPPLIER
  BOTH
}

model Party {
  id   String    @id @default(cuid())
  type PartyType @default(CUSTOMER)

  name  String
  phone String?
  email String?

  gstin   String? // party's own GSTIN, when registered — needed for GST invoicing (Phase 2)
  address String?
  state   String? // used to determine CGST+SGST (same state as business) vs IGST (different state)

  openingBalanceInr Float @default(0) // positive = party owes the business

  notes  String?
  active Boolean @default(true)

  // Phase 2 back-relations
  sales     SalesInvoice[] @relation("PartySales")
  purchases PurchaseBill[] @relation("PartyPurchases")
  expenses  Expense[]      @relation("PartyExpenses")
  registerEntries RegisterEntry[] @relation("PartyRegister")
  oilReceipts     OilReceipt[]    @relation("PartyOilReceipts")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Inventory / SKU master (erp-architecture-plan.md, Phase 1). Sales/
// Purchase (Phase 2) and POS (Phase 3) reference this rather than
// free-text item names.
model Item {
  id String @id @default(cuid())

  name String
  sku  String? @unique // shop's own code, optional
  unit String  @default("kg") // kg, ltr, pcs, ...

  hsnCode      String? // GST HSN/SAC code
  gstRatePct   Float? // overrides BusinessSettings.defaultGstRatePct when set
  barcode      String? @unique // reserved for future barcode/QR scanning (Phase 3) — not enforced yet

  openingStockQty Float  @default(0)
  reorderLevelQty Float? // below this, a future low-stock report/flag can trigger

  notes  String?
  active Boolean @default(true)

  // Phase 2 back-relations
  salesLines    SalesLineItem[]    @relation("ItemSales")
  purchaseLines PurchaseLineItem[] @relation("ItemPurchases")
  adjustments   StockAdjustment[]  @relation("ItemAdjustments")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Singleton business profile + GST settings (erp-architecture-plan.md,
// Phase 1). Enforced as a singleton at the application layer (always
// read/write the one row with a well-known id), not by a DB constraint —
// simplest option for a single-business app; revisit only if this ever
// needs to become multi-tenant (explicitly out of scope for now).
model BusinessSettings {
  id String @id @default("singleton")

  businessName String @default("")
  gstin        String? // business's own GSTIN — Regular dealer (erp-architecture-plan.md)
  address      String?
  state        String? // business's home state — compared against a party's state for CGST+SGST vs IGST
  phone        String?
  email        String?

  defaultGstRatePct Float  @default(5) // used when an Item has no gstRatePct of its own
  invoicePrefix     String @default("INV-")
  invoiceCounter    Int    @default(0) // last-used invoice number; Sales (Phase 2) increments this atomically

  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Phase 2 — Core ledgers (erp-architecture-plan.md). Sales (GST invoicing),
// Purchase (supplier bills), Expense recording. All additive.
//
// Design notes:
// - Line items snapshot the item's name/hsn/rate/gstRate at entry time, so a
//   later edit to the Item master never rewrites historical invoices.
// - GST is computed and stored on the row (subtotal/cgst/sgst/igst/total) by
//   the API route via lib/gst.ts — not recomputed on read — so the numbers a
//   customer saw on their invoice are stable forever.
// - itemId is optional on every line: a one-off line ("misc", "labour") that
//   isn't in the Item master is still allowed. When present it references Item
//   and is SetNull on delete so archiving an item never destroys invoice
//   history.
// - partyId is a real FK; Restrict on delete so a party with any ledger
//   activity can't be hard-deleted out from under its transactions (the UI
//   only ever soft-deletes parties anyway).
// ---------------------------------------------------------------------------

enum PaymentMode {
  CASH
  UPI
  BANK
  CREDIT // unpaid / on account
  OTHER
}

model SalesInvoice {
  id        String @id @default(cuid())
  invoiceNo String @unique // formatted from BusinessSettings.invoicePrefix + counter

  date    String // "YYYY-MM-DD" business date of the invoice
  partyId String
  party   Party  @relation("PartySales", fields: [partyId], references: [id], onDelete: Restrict)

  // Snapshotted at issue time so a later Party/Settings edit never rewrites a
  // historical invoice's tax treatment.
  partyStateSnapshot    String?
  businessStateSnapshot String?
  interState            Boolean @default(false) // true => IGST; false => CGST+SGST

  subtotalInr Float @default(0)
  cgstInr     Float @default(0)
  sgstInr     Float @default(0)
  igstInr     Float @default(0)
  totalInr    Float @default(0)

  paymentMode PaymentMode @default(CASH)
  notes       String?

  lineItems SalesLineItem[]
  returns   SalesReturn[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([partyId])
  @@index([date])
}

// A refund (credit note) against a sale. Lines are a JSON snapshot so the
// record stays exact even if the item is renamed later. Returned stock is
// added back via SalesLineItem.returnedQty.
model SalesReturn {
  id        String       @id @default(cuid())
  invoiceId String
  invoice   SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  reason    String
  note      String?
  refundInr Float
  lines     Json
  createdAt DateTime     @default(now())

  @@index([invoiceId])
}

model SalesLineItem {
  id        String       @id @default(cuid())
  invoiceId String
  invoice   SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  itemId String?
  item   Item?   @relation("ItemSales", fields: [itemId], references: [id], onDelete: SetNull)

  name       String // snapshot of item name (or free-text one-off)
  hsnCode    String?
  qty        Float   @default(0)
  unit       String  @default("kg")
  rateInr    Float   @default(0) // per-unit, pre-tax
  gstRatePct Float   @default(0)
  discountPct Float  @default(0) // line discount %, applied before GST
  returnedQty Float  @default(0) // quantity refunded so far (see SalesReturn)

  lineSubtotalInr Float @default(0) // qty * rate
  lineTaxInr      Float @default(0) // lineSubtotal * gstRate/100
  lineTotalInr    Float @default(0) // subtotal + tax

  @@index([invoiceId])
}

model PurchaseBill {
  id     String @id @default(cuid())
  billNo String // the SUPPLIER's bill/invoice number (not unique on our side)

  date    String
  partyId String
  party   Party  @relation("PartyPurchases", fields: [partyId], references: [id], onDelete: Restrict)

  partyStateSnapshot    String?
  businessStateSnapshot String?
  interState            Boolean @default(false)

  subtotalInr Float @default(0)
  cgstInr     Float @default(0)
  sgstInr     Float @default(0)
  igstInr     Float @default(0)
  totalInr    Float @default(0)

  paymentMode PaymentMode @default(CREDIT)
  notes       String?

  lineItems PurchaseLineItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([partyId])
  @@index([date])
}

model PurchaseLineItem {
  id     String       @id @default(cuid())
  billId String
  bill   PurchaseBill @relation(fields: [billId], references: [id], onDelete: Cascade)

  itemId String?
  item   Item?   @relation("ItemPurchases", fields: [itemId], references: [id], onDelete: SetNull)

  name       String
  hsnCode    String?
  qty        Float   @default(0)
  unit       String  @default("kg")
  rateInr    Float   @default(0)
  gstRatePct Float   @default(0)

  lineSubtotalInr Float @default(0)
  lineTaxInr      Float @default(0)
  lineTotalInr    Float @default(0)

  @@index([billId])
}

model Expense {
  id String @id @default(cuid())

  date      String
  category  String // free text for now (e.g. "Electricity", "Transport", "Salary")
  amountInr Float  @default(0)

  // Optional link to a party (e.g. a transporter or landlord in the master).
  partyId String?
  party   Party?  @relation("PartyExpenses", fields: [partyId], references: [id], onDelete: SetNull)

  paymentMode PaymentMode @default(CASH)
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

// Vyapar cross-check snapshot (erp-architecture-plan.md). Vyapar is the
// accountant's source-of-truth software and has NO API, so this is a
// SNAPSHOT parsed from its .vyb backup (05_Scripts/vyapar_reader.py) and
// pushed in via PUT /api/vyapar. Purpose: cross-check the rebuild's own
// entries and the physical stock on the floor against what the accountant
// has in Vyapar, as of the latest backup. Singleton — one current snapshot,
// replaced each time a newer backup is read. The parsed figures live in the
// JSON `payload` (shape: VyaparSnapshotPayload in lib/types.ts) so the
// reader can evolve without a schema migration.
model VyaparSnapshot {
  id      String @id @default("singleton")
  payload Json

  updatedAt DateTime @updatedAt
}

// The two fixed daily counts (see sop-daily-cash-stock-closing.md).
enum ClosingSession {
  AFTERNOON
  NIGHT
}

model JobWorkIntake {
  id String @id @default(cuid())

  customer  String
  vehicleNo String? // "Auto / vehicle no." — optional, used for payment split

  seedKg Float

  cakeOwnership CakeOwnership @default(SHOP)

  // Advances taken at intake, split customer/auto (Version 13 of the plan doc)
  advanceCustomerInr Float @default(0)
  advanceAutoInr     Float @default(0)

  // Oil cans taken at intake (Version 14): {"can15": {"qty":1,"rate":50}, ...}
  // Keys match CAN_TYPES in lib/calculations.ts; rate is captured at the
  // moment of intake so a later price change never rewrites history.
  cans Json?

  notes String?

  // Settlement (filled in when the entry is paid/settled)
  settled                Boolean   @default(false)
  settlementCustomerInr  Float?
  settlementAutoInr      Float?
  settlementRatePerKg    Float?
  settlementAmountInr    Float?
  settledAt              DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DailyClosing {
  id String @id @default(cuid())

  date    String // "YYYY-MM-DD" — the business date this count belongs to
  session ClosingSession

  // Cash in
  cashInOpening Float @default(0)
  cashInSales   Float @default(0)
  cashInOther   Float @default(0)

  // Cash out
  cashOutGrn      Float @default(0) // job-work Scenario A payouts
  cashOutExpenses Float @default(0)
  cashOutSalary   Float @default(0)
  cashOutUpi      Float @default(0)
  cashOutDraw     Float @default(0)
  cashOutOther    Float @default(0)

  // Physical count
  counterCashInr Float @default(0)

  // Computed + snapshotted at submit time (see getYesterdayStock's
  // "most recent prior entry" note in lib/calculations.ts)
  systemCashInr Float @default(0)
  cashDiffInr   Float @default(0)
  cashMismatch  Boolean @default(false) // |diff| >= ₹300

  // 10-product oil-stock tally, snapshotted at submit time:
  // { sf: {today, reportSale, yesterday, sale, gap}, karadi1: {...}, k2: {today, yesterday, diff}, ... }
  stock Json?

  // Quick Register additions (additive, nullable). When a count is taken
  // from the Quick Register, the note/coin breakdown is kept here and
  // `source` is "register"; counts entered on the Daily Closing desk leave
  // both null.
  denoms Json?
  source String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Manufacturing — self-crushing barrel/batch yield tracking (plan doc,
// Versions 19-20). A batch is a multi-day thing: Step 1 (crude oil in)
// starts it; Steps 2-4 (settling) are logged as they happen. It becomes
// "complete" and gets scored once both Step 3 and Step 4 are logged.
// The yield analysis (actual oil, efficiency, short/extra, mass-balance
// loss, oil-cake cross-check) is computed by lib/mfgCalculations.ts and
// snapshotted onto `yield` at each save so history stays stable.
model MfgBatch {
  id String @id @default(cuid())

  mill        String? // which mill
  barrel      String  // barrel/batch label — letters allowed (e.g. "A1")
  productItem String  @default("Karadi oil") // oil being produced
  date        String  // start (Step 1) date, "YYYY-MM-DD"

  // Up to two suppliers: [{ "name": "...", "seedKg": 600 }, ...]
  suppliers Json

  step1Kg Float? // crude oil pumped in at crush time
  step2Kg Float? // partial skim (after 2-3 days)
  step3Kg Float? // full decant (after 3-4 days)
  step4Kg Float? // waste / sediment removed (~= oil cake)

  // Per-step date+time, auto-stamped when that step's kg is entered but
  // fully editable (plan doc, Version 20). "YYYY-MM-DD" / "HH:MM".
  step2Date String?
  step2Time String?
  step3Date String?
  step3Time String?
  step4Date String?
  step4Time String?

  refOilPct           Float  @default(22) // per-batch reference yield %
  moisturePct         Float? // default 1.5 if null (see calc module)
  systemOilKgOverride Float? // explicit expected-oil override
  seedQuality         String? // optional, informational only (Version 20)

  notes String?

  // Snapshotted yield analysis at last save (from computeBarrelYield()).
  yield Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Physical Karadi tank evidence is separate from accounting stock.
// A sampled weight never creates an IN/OUT transaction by itself.
model TankReading {
  id        String   @id @default(cuid())
  source    String
  weightKg  Float
  bucketAt  DateTime
  createdAt DateTime @default(now())

  @@unique([source, bucketAt])
  @@index([source, createdAt])
}

model TankMovement {
  id            String   @id @default(cuid())
  source        String
  direction     String // IN or OUT, derived from before/after weight
  beforeKg      Float
  afterKg       Float
  quantityKg    Float
  startedAt     DateTime
  finishedAt    DateTime @default(now())
  note          String?
  recordedBy    String
  requestId     String   @unique // a retry cannot double count the movement

  @@index([source, finishedAt])
}

// Owner-maintained connection notebook. This contains device/network
// configuration, not Wi-Fi passwords or live readings.
model ScaleConnectionProfile {
  id          String   @id @default(cuid())
  source      String   @unique
  name        String
  model       String
  mode        String   // SI850_POLL, TCP_SERVER_RAW, TCP_LISTENER_RAW, SERIAL_RAW
  topology    String   // DIRECT, SWITCH, ROUTER_LAN, WIFI_BRIDGE, WIFI_NATIVE, USB_SERIAL, RS232
  scaleHost   String?
  scalePort   Int?
  pcIp        String?
  subnetMask  String?
  gateway     String?
  adapter     String?
  routerIp    String?
  serialPort  String?
  baudRate    Int?
  dataBits    Int?
  parity      String?
  stopBits    Int?
  browserPort Int      @default(8765)
  enabled     Boolean  @default(true)
  verified    Boolean  @default(false)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Quick Register — the simple, icon-first, bilingual counter cash book used
// by the shop manager at the moment of each transaction (sale, purchase,
// expense, payment, pigmee, owner withdrawal). It is a CASH BOOK, not a GST
// ledger: the accountant still enters full invoices in Vyapar / the Sales &
// Purchase desks later. Job-work is NOT stored here — the Quick Register
// writes job-work straight into JobWorkIntake (same rows the Job-Work Desk
// shows), and the two daily cash counts are written into DailyClosing
// (AFTERNOON = Tally 1, NIGHT = Tally 2), so there is one source of truth.
// ---------------------------------------------------------------------------

enum RegisterKind {
  SALE        // money in
  FRESH_CRUSH // money in — oil crushed from the shop's own seed in front of the customer
  UDHAAR_IN   // money in — old credit collected
  PURCHASE    // money out
  EXPENSE     // money out
  PAYMENT     // money out — salary / supplier / other
  PIGMEE      // cash leaves counter, NOT an expense
  OWNER_DRAW  // Sahil takes cash, NOT an expense
}

model RegisterEntry {
  id   String       @id @default(cuid())
  date String // "YYYY-MM-DD" business date
  kind RegisterKind

  item      String? // catalog key ("sunflower", "diesel", "salary", ...) or custom key
  itemLabel String? // human label snapshot (custom / "Other" items)
  qty       Float?
  unit      String? // kg, ltr, bags, pcs, box
  rateInr   Float?
  amountInr Float

  paymentMode PaymentMode @default(CASH)
  totalSale   Boolean     @default(false) // Sale entered as one scale-slip total
  drawKind    String? // OWNER_DRAW: "partial" | "full"

  partyName String?
  partyId   String?
  party     Party?  @relation("PartyRegister", fields: [partyId], references: [id], onDelete: SetNull)

  // Kind-specific extra data. FRESH_CRUSH: { seedKg, oilKg, soldKg?, extraKg,
  // extraTo?, cakeKg } — see FreshCrushDetails in lib/register.ts.
  details Json?

  notes         String?
  createdByName String?

  // Proofs of payment / scanned slips attached to this entry (see Attachment).
  attachments Attachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([partyId])
}

// Singleton Quick Register settings: per-item rates, custom items library,
// pigmee default, default language mode, opening-cash overrides. JSON so the
// register can grow without migrations (shape: RegisterConfigData in
// lib/register.ts).
model RegisterConfig {
  id   String @id @default("singleton")
  data Json

  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Proofs & scans (lib/proofs.ts). One row per saved image:
//  - proof of payment: SIGNATURE drawn on screen, RECIPIENT_PHOTO, or
//    THUMB_PAPER (photo of an inked thumb / signed paper voucher), linked to
//    the Quick Register money-out entry it proves;
//  - scanned slips: WEIGHBRIDGE, WEIGHING, BILL, RECEIPT, with the fields the
//    AI read (after the person checked them) in `fields`.
// The image itself is filed in Google Drive (06_Scans_&_Proofs/<Category>/
// <YYYY-MM>/) when the Drive upload is set up. Until it uploads, the image
// is kept here in `dataUrl` so nothing is lost; a retry moves it to Drive
// and clears `dataUrl`. Deleting the register entry keeps the proof
// (registerEntryId -> null) so the audit trail survives.
// ---------------------------------------------------------------------------
model Attachment {
  id   String @id @default(cuid())
  kind String // ProofKind in lib/proofs.ts
  date String // "YYYY-MM-DD" business date

  registerEntryId String?
  registerEntry   RegisterEntry? @relation(fields: [registerEntryId], references: [id], onDelete: SetNull)

  fileName  String
  folder    String // "06_Scans_&_Proofs/Payment_Signatures/2026-10"
  mime      String
  sizeBytes Int    @default(0)

  driveFileId String?
  driveUrl    String?
  driveError  String?
  dataUrl     String? // image kept here until it is uploaded to Drive

  partyName String?
  amountInr Float?
  refNo     String? // slip / bill / receipt number
  fields    Json? // scanned slip fields (checked by the person), ScanFields
  aiFields  Json? // what the AI first read, kept for comparison
  notes     String?

  // Where / when it was captured (taken on the device, not typed).
  capturedAt DateTime?
  geo        Json? // { lat, lng, acc } when the phone allowed location
  device     String?

  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([date])
  @@index([kind])
  @@index([registerEntryId])
}

// ---------------------------------------------------------------------------
// Barrel receiving — oil bought in barrels from a factory / trader.
// Each barrel gets a barcode label, is weighed FULL on the platform scale,
// emptied into the tank, then weighed EMPTY. Net oil = full − empty, added up
// per lot and compared with the supplier's challan (lib/barrels.ts).
//
// Weights come from `ScaleTick` rows the scale bridge posts itself (settled
// readings only), so a weight on a barrel can be traced to a real scale
// reading. A weight typed by hand is allowed but marked MANUAL and flagged.
// Every action is also written to BarrelEvent (append-only audit trail).
// ---------------------------------------------------------------------------
model OilReceipt {
  id            String   @id @default(cuid())
  lotNo         String   @unique // "R261010-1"
  date          String // "YYYY-MM-DD" business date
  partyId       String?
  party         Party?   @relation("PartyOilReceipts", fields: [partyId], references: [id], onDelete: SetNull)
  supplierName  String
  product       String // "Sunflower oil", "Rice bran oil" …
  vehicleNo     String?
  challanNo     String? // supplier's challan / invoice number
  rateInrPerKg  Float?
  declaredNetKg Float? // total oil the supplier says is in the lot
  declaredBarrels Int?
  tankTarget    String? // tank the oil is poured into
  status        String   @default("OPEN") // OPEN | CLOSED
  closedAt      DateTime?
  closedBy      String?
  closeNote     String?
  notes         String?
  createdBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  barrels Barrel[]
  events  BarrelEvent[]

  @@index([date])
  @@index([status])
}

model Barrel {
  id        String     @id @default(cuid())
  receiptId String
  receipt   OilReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  seq       Int
  code      String     @unique // printed in the barcode, "R261010-1-03"
  supplierMark String? // number / mark painted on the supplier's barrel
  declaredNetKg Float? // supplier's figure for this barrel, when given

  grossKg     Float?
  grossAt     DateTime?
  grossBy     String?
  grossSource String? // SCALE | MANUAL
  grossScale  String?
  grossTickId String?
  grossNote   String?
  grossRecordedAt DateTime? // when the system saved it; grossAt is when it was weighed

  emptyKg     Float?
  emptyAt     DateTime?
  emptyBy     String?
  emptySource String?
  emptyScale  String?
  emptyTickId String?
  emptyNote   String?
  emptyRecordedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([receiptId, seq])
  @@index([receiptId])
}

model BarrelEvent {
  id        String     @id @default(cuid())
  receiptId String
  receipt   OilReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  barrelCode String?
  action    String // CREATE | LABELS | GROSS | EMPTY | REWEIGH | EDIT | ADD_BARRELS | CLOSE | REOPEN
  detail    Json?
  by        String
  at        DateTime @default(now())

  @@index([receiptId, at])
}

// A settled (steady) reading the scale bridge pushed to the server. One tick
// can be used for ONE weighment, within two minutes of settling.
model ScaleTick {
  id        String   @id @default(cuid())
  source    String // "PLATFORM-1"
  weightKg  Float
  unit      String   @default("kg")
  nonce     String   @unique // bridge-made id, so a retry cannot double-post
  settledAt DateTime
  createdAt DateTime @default(now())

  usedBarrelCode String?
  usedPhase      String?
  usedAt         DateTime?

  @@index([source, settledAt])
}

// ---------------------------------------------------------------------------
// Barrel fleet — the shop's OWN reusable barrels (about 20), rotated between
// storage, transport, purchase and sale. Unlike `Barrel` above (one row per
// supplier lot, used once), a FleetBarrel keeps one permanent code (BRL-07) and
// one registered tare, and every weighing and movement is appended to
// FleetEvent. Net oil = gross − tare (lib/barrelFleet.ts). Weights come from the
// same `ScaleTick` readings the platform scale bridge posts.
// ---------------------------------------------------------------------------
model FleetBarrel {
  id         String    @id @default(cuid())
  code       String    @unique // printed on the label, "BRL-07"
  mark       String? // paint mark / description, "blue, dent on lid"
  capacityKg Float     @default(190) // most oil it may take (usual fill 180 kg)
  tareKg     Float? // registered empty weight, used for every net weight
  tareAt     DateTime?
  tareBy     String?
  status     String    @default("NEW") // NEW (no tare yet) | EMPTY | FULL
  product    String? // oil inside now
  grossKg    Float? // last full weight (oil + barrel)
  grossAt    DateTime?
  netKg      Float? // oil inside as of the last full weighing
  lastGrossDiffKg Float? // last full weight minus the full weight before it
  lastEmptyKg Float? // last empty weight seen (compare with tareKg)
  lastEmptyAt DateTime?
  location   String    @default("SHOP") // SHOP | VEHICLE | CUSTOMER | SUPPLIER | REPAIR
  holder     String? // who has it when it is not in the shop
  sinceAt    DateTime  @default(now()) // in this place since
  condition  String    @default("OK") // OK | DENTED | LEAKING | RETIRED
  notes      String?
  active     Boolean   @default(true)
  createdBy  String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  events FleetEvent[]

  @@index([location])
  @@index([status])
}

// Append-only ledger: one row per weighing, movement or change of a fleet barrel.
model FleetEvent {
  id         String      @id @default(cuid())
  barrelId   String
  barrel     FleetBarrel @relation(fields: [barrelId], references: [id], onDelete: Cascade)
  barrelCode String
  action     String // REGISTER | GROSS | EMPTY | MOVE | EDIT
  at         DateTime // when it happened (a scale weighing: when the scale settled)
  recordedAt DateTime    @default(now()) // when the system saved it
  by         String
  source     String? // SCALE | MANUAL (weighings)
  scale      String?
  tickId     String?
  kg         Float? // the weight read on the scale
  tareKg     Float? // tare in force at that moment
  netKg      Float? // oil: gross − tare (full weighing) or oil sent out
  product    String?
  fromLoc    String?
  toLoc      String?
  party      String? // customer / supplier / holder
  vehicleNo  String?
  purpose    String? // SALE | TRANSPORT | STORAGE | REFILL | OTHER
  ref        String? // challan / invoice / LR number
  note       String?
  detail     Json? // driftKg, diffKg, pouredKg, previous values …

  @@index([barrelCode, at])
  @@index([at])
}

// Bill builder — a bill put on hold at the counter. The draft (lines, party,
// date, payment mode, notes) is stored as JSON and restored on resume. Held
// bills do NOT reserve stock; stock moves only when the bill is saved.
model HeldBill {
  id        String   @id @default(cuid())
  label     String   // shown in the list, e.g. party name or "Walk-in"
  partyId   String?
  draft     Json
  heldBy    String?  // session user name, for the list
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Stock corrections are separate entries, never edits to the stock figure.
// qtyDelta > 0 adds stock, < 0 removes it. A correction is undone by a new
// REVERSAL entry that points at it through reversesId (unique: once only).
enum AdjustmentReason {
  COUNT_DIFFERENCE // physical count differs from the book
  BREAKAGE         // bottle / can broke, leaked
  SPILLAGE         // spilled during filling or transfer
  OPENING_CORRECTION // opening balance was wrong
  OTHER            // note required
  REVERSAL         // undoes an earlier correction
}

model StockAdjustment {
  id String @id @default(cuid())

  date   String // "YYYY-MM-DD" business date
  itemId String
  item   Item   @relation("ItemAdjustments", fields: [itemId], references: [id], onDelete: Cascade)

  bookQty   Float // system book quantity at the moment of correction
  actualQty Float // counted / corrected quantity (for REVERSAL, the quantity after undo)
  qtyDelta  Float // actualQty - bookQty, signed; the amount this entry moves stock by

  reason AdjustmentReason
  note   String?

  reversesId String? @unique

  createdAt DateTime @default(now())

  @@index([itemId, date])
}


// Access profiles: which pages / Quick Register functions / windows a user gets and
// which data is hidden (lib/access.ts). Built-in profiles ("owner", "manager",
// "counter", "godown") live in code; a row here overrides their toggles, and custom
// profiles exist only as rows.
model AccessProfile {
  id        String   @id
  name      String
  who       String   @default("")
  perms     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Cash tally helpers (lib/memoTotals.ts, lib/scaleReport.ts). These stay
// SEPARATE from the register: they never create RegisterEntry rows and never
// feed sales / stock / GST / party reports. Only the Cash tally reads them.
// ---------------------------------------------------------------------------

// Day totals typed from the paper cash memo sheet: one row per date per line.
model CashMemoTotal {
  id            String   @id @default(cuid())
  date          String // "YYYY-MM-DD" business date
  line          String // SALE | PURCHASE | EXPENSE | JOBWORK | UDHAAR | SALARY
  amountInr     Float // total on the memo sheet
  cashInr       Float // of which cash (defaults to all)
  qty           Float?
  unit          String?
  source        String   @default("typed") // typed | scale-scan | paper-scan
  enteredByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([date, line])
  @@index([date])
}

// Weighing-scale "PLU - Daily Report" read from a photo (one per date).
model ScaleReportScan {
  id            String   @id @default(cuid())
  date          String   @unique
  totalKg       Float?
  totalInr      Float?
  taxInr        Float?
  lines         Json // [{ name, key, kg, pcs, amountInr }]
  enteredByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Shift handover note: who counted the cash and who it was handed to.
model CashHandover {
  id            String   @id @default(cuid())
  date          String
  session       String // AFTERNOON | NIGHT
  countedBy     String
  handedTo      String
  enteredByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([date, session])
}

// Append-only record of every Cash tally save / change / delete (who, when, old and new value).
// Rows are only ever added, never edited or removed, so the history survives refreshes and corrections.
model CashTallyLog {
  id            String   @id @default(cuid())
  date          String // business date the entry belongs to
  line          String // SALE | PURCHASE | ... | UPI_GPAY | OPENING | OTHER_IN | OWNER_DRAW | SCALE | COUNT | HANDOVER
  action        String // SAVE | DELETE
  amountInr     Float? // new value (null on delete)
  prevInr       Float? // value before this change
  session       String? // AFTERNOON | NIGHT for counts / handovers
  note          String?
  enteredByName String?
  createdAt     DateTime @default(now())

  @@index([date, createdAt])
}

// ---------------------------------------------------------------------------
// Print queue — lets a phone or tablet print on the shop's own printers. The
// device makes a picture of each label / slip at the exact paper size and
// queues it here; tools/print_helper.py on the shop PC (USB printers attached)
// fetches the job and prints it. No Bluetooth needed.
// ---------------------------------------------------------------------------
model PrintJob {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  createdBy String
  kind      String // "label" | "slip"
  title     String    @default("")
  widthMm   Float
  heightMm  Float?
  copies    Int       @default(1)
  items     Json // [{ png: base64, widthMm, heightMm }]
  status    String    @default("QUEUED") // QUEUED | PRINTING | DONE | FAILED | CANCELLED
  error     String?
  claimedAt DateTime?
  doneAt    DateTime?
  agent     String?

  @@index([status, createdAt])
}

// One row per print helper that has called in: shows "shop printer online" in the app.
model PrintAgent {
  id       String   @id // "shop"
  lastSeen DateTime
  version  String   @default("")
  dryRun   Boolean  @default(false)
  info     Json? // { labelPrinter, slipPrinter }
}

// Label and receipt layouts made in the designer (shared by every device). One default per kind.
model LabelTemplate {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  name      String
  kind      String // "label" | "slip"
  widthMm   Float
  heightMm  Float? // null = roll slip, as long as its content
  doc       Json // see lib/labelTemplate.ts
  isDefault Boolean  @default(false)
  updatedBy String   @default("")

  @@index([kind, updatedAt])
}
