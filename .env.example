# Every setting the app reads, with what it does. Names only: copy this file to
# `.env` (local) or add the same names in Vercel -> Project -> Settings ->
# Environment Variables, and fill in the values. Never commit real values.
#
# Only DATABASE_URL and NEXTAUTH_SECRET are needed to run the app. Everything
# else switches on one optional feature and is safe to leave empty; that feature
# then shows "not set up" and the rest of the app keeps working.
#
# NODE_ENV and VERCEL are set by Next.js / Vercel themselves; do not set them here.

# ---------------------------------------------------------------- Required

# PostgreSQL connection string for Prisma (Vercel Postgres, Neon, Supabase or a
# local Postgres all work). If it is left empty the pages still render and show a
# "Database not connected yet" banner (lib/db.ts). Create the tables with
# `npx prisma db push`; on Vercel, `npm run build` does this for you
# (scripts/db-push.js).
# Example: postgresql://user:password@host:5432/dbname?schema=public
DATABASE_URL=

# Signs the login session. Use a long random string. Also used by the middleware.
NEXTAUTH_SECRET=

# ---------------------------------------------------------------- Sign-in and links

# Public address of the app, used when the chat bot builds links.
# Example: https://mahadev-second-brain.vercel.app
NEXTAUTH_URL=

# ---------------------------------------------------------------- Scheduled jobs

# Secret for the nightly job at /api/bot/cron (task reminders, digest, backup).
# The job checks the header "Authorization: Bearer <this value>". WARNING: while
# this is empty the endpoint is open to anyone who knows the address, so set it.
CRON_SECRET=

# ---------------------------------------------------------------- Scales and printers

# Shared secret (at least 16 characters) that the shop PC's scale bridge
# (tools/scale_bridge.py) sends with each reading to /api/scale-ticks/ingest.
# Also accepted as the key for the print agent.
SCALE_PUSH_SECRET=

# Optional separate secret (at least 16 characters) for the print agent that
# collects queued label and slip jobs (tools/print_helper.py). If empty, the
# print agent uses SCALE_PUSH_SECRET instead.
PRINT_QUEUE_SECRET=

# ---------------------------------------------------------------- Google Drive filing

# Web-app address and shared secret of the Apps Script in tools/drive-upload.gs,
# which files signatures, payment photos and scanned slips into Google Drive.
# Both must be set for uploads to switch on.
DRIVE_UPLOAD_URL=
DRIVE_UPLOAD_SECRET=

# ---------------------------------------------------------------- AI (all free-tier)

# Fills forms from a bill photo, speech or text, and answers questions. The
# providers are tried in this order and the first one that answers wins
# (lib/aiProvider.ts). With no key at all, the AI buttons say "not configured".
# Keys: https://aistudio.google.com/apikey , https://openrouter.ai/keys ,
# https://console.groq.com/keys
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Optional: pin a provider to exactly one model instead of its built-in list.
GEMINI_MODEL=
OPENROUTER_MODEL=
GROQ_MODEL=

# ---------------------------------------------------------------- Market prices

# data.gov.in key for the daily mandi (market) prices. If empty, the app uses
# the public sample key, which is rate-limited.
DATA_GOV_API_KEY=

# ---------------------------------------------------------------- Sharing reports

# Where "Share" can send a report. Each one switches on when it is set.
# Telegram needs both the bot token and the chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
# Any web address that accepts a POST with the report (for example a Zapier hook).
REPORT_WEBHOOK_URL=

# ---------------------------------------------------------------- WhatsApp orders

# WhatsApp Business Cloud API, for customer orders arriving at /api/wa.
# The feature is on only when TOKEN, PHONE_ID and APP_SECRET are all set.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# The app secret from the Meta app; incoming messages are checked against it.
WHATSAPP_APP_SECRET=
# Text you type into Meta's webhook set-up screen so it can verify the address.
WHATSAPP_VERIFY_TOKEN=
